# career-ops cloud loop — set these as Railway service Variables, never commit real values.

# ── Claude (one of the two) ──
CLAUDE_CODE_OAUTH_TOKEN=        # from `claude setup-token` (uses your Claude Pro/Max plan)
# ANTHROPIC_API_KEY=            # pay-per-token API key instead

# ── Telegram: dedicated bot for buttons + commands ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Optional: also/instead route alerts through your email-alert service ──
ALERT_API_URL=                  # https://your-email-alert.up.railway.app
ALERT_API_KEY=                  # its LOCAL_API_KEY
ALERT_DESTINATION=              # destination name, if it has several

# ── Data persistence + autofix (fine-grained PAT: contents + pull requests, both repos) ──
GITHUB_TOKEN=
DATA_REPO=you/career-ops-data   # PRIVATE repo holding cv.md, config/, modes/_profile.md, portals.yml, data/, reports/
DATA_BRANCH=main
CODE_REPO=you/career-ops        # your fork that Railway deploys
CODE_BRANCH=main

# ── Loop behaviour ──
TZ=America/Los_Angeles
LOOP_INTERVAL_MIN=30
LOOP_SCAN_EVERY_HOURS=6
LOOP_MAX_EVALS_PER_CYCLE=2
LOOP_DAILY_CAP=8
LOOP_SCORE_GATE=4.0
LOOP_ACTIVE_HOURS=7-23
LOOP_SUMMARY_HOUR=20
LOOP_BREAKER_THRESHOLD=3
LOOP_RCA=1
LOOP_AUTOFIX=0
# LOOP_MODEL=
HEALTHCHECK_PING_URL=           # https://hc-ping.com/<uuid> — alerts you if the loop goes silent
